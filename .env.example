# PsicoApp — variáveis de ambiente (copie para .env e preencha)
# NUNCA commite .env. Em produção, usar secret manager (ex.: AWS Secrets Manager).

# --- Database ---
POSTGRES_USER=psicoapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=psicoapp
DATABASE_URL=postgres://psicoapp:changeme@localhost:5432/psicoapp

# --- Backend ---
PORT=3001
NODE_ENV=development
# JWT: segredos com no mínimo 32 bytes aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=change-me-min-32-bytes-random
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# AES-256-GCM para campos clínicos (anamnese, prontuário) — 32 bytes em hex/base64
FIELD_ENCRYPTION_KEY=change-me-32-bytes-base64

# --- Seed (somente dev) ---
# Senha do usuário demo criado por `npm run db:seed` — nunca roda automaticamente
SEED_DEMO_PASSWORD=change-me-dev-only

# --- Segurança ---
# Origem permitida do frontend (lista separada por vírgula)
CORS_ORIGIN=http://localhost:3000

# --- E-mail (reset de senha) ---
# No dev, Mailpit do docker-compose recebe tudo (UI em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=PsicoApp <no-reply@psicoapp.local>
# URL pública do frontend — base dos links enviados por e-mail
APP_URL=http://localhost:3000

# --- Frontend (Vite) ---
VITE_API_URL=/api
